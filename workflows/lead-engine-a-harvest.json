      "id": "read_existing_leads",
      "name": "Read existing leads",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        2080,
        208
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const existingRows = $('Read existing leads').all();\nconst seen = new Set();\nfor (const r of existingRows) {\n  const pid = r.json && r.json.place_id;\n  if (pid) seen.add(String(pid));\n}\nconst localSeen = new Set();\nconst out = [];\nfor (const item of $('Map + filter').all()) {\n  const pid = item.json.place_id;\n  if (!pid) continue;\n  const key = String(pid);\n  if (seen.has(key)) continue;\n  if (localSeen.has(key)) continue;\n  localSeen.add(key);\n  out.push({ json: item.json });\n}\nreturn out;"
      },
