      "id": "fetch_dataset",
      "name": "Fetch dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1648,
        208
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Apify (lead engine)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const parsed = $('Parse config').first().json;\nconst cfg = parsed.config;\nconst city = parsed.city;\nconst excludes = (cfg.excludeNamePatterns || []).map(p => String(p).toLowerCase());\n\nlet places = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  if (Array.isArray(j)) places.push(...j);\n  else if (j && Array.isArray(j.data)) places.push(...j.data);\n  else places.push(j);\n}\n\nconst out = [];\nfor (const p of places) {\n  if (!p || typeof p !== 'object') continue;\n  if (p.permanentlyClosed === true || p.temporarilyClosed === true) continue;\n  if (!p.placeId) continue;\n  const title = String(p.title || '');\n  const lowerTitle = title.toLowerCase();\n  if (excludes.some(x => x && lowerTitle.includes(x))) continue;\n\n  const reviews = Array.isArray(p.reviews) ? p.reviews : [];\n  let latest = '';\n  for (const r of reviews) {\n    const d = (r && r.publishedAtDate) ? r.publishedAtDate : '';\n    if (d && d > latest) latest = d;\n  }\n\n  const mapped = reviews\n    .filter(r => r && r.text && String(r.text).trim() !== '')\n    .map(r => ({\n      text: r.text,\n      date: r.publishedAtDate || '',\n      stars: (r.stars != null) ? r.stars : null,\n      ownerResponse: r.responseFromOwnerText || null,\n      ownerResponseDate: r.responseFromOwnerDate || null,\n    }));\n\n  let trimmed = mapped.slice();\n  let reviewsJson = JSON.stringify(trimmed);\n  while (reviewsJson.length > 30000 && trimmed.length > 0) {\n    trimmed.pop();\n    reviewsJson = JSON.stringify(trimmed);\n  }\n\n  let hasHours = false;\n  if (p.openingHours) {\n    hasHours = Array.isArray(p.openingHours) ? p.openingHours.length > 0 : Object.keys(p.openingHours).length > 0;\n  }\n  const signals = {\n    bookingLinks: Array.isArray(p.bookingLinks) ? p.bookingLinks : [],\n    claimed: !p.claimThisBusiness,\n    imagesCount: (p.imagesCount != null) ? p.imagesCount : 0,\n    hasHours: hasHours,\n  };\n\n  out.push({ json: {\n    place_id: p.placeId,\n    name: title,\n    city: city,\n    country: p.countryCode || 'GB',\n    address: p.address || '',\n    phone: p.phone || p.phoneUnformatted || '',\n    website: p.website || '',\n    gmaps_url: p.url || '',\n    review_count: p.reviewsCount || 0,\n    rating: p.totalScore || 0,\n    latest_review_date: latest,\n    reviews_json: reviewsJson,\n    status: 'raw',\n    classification: '',\n    evidence: '',\n    signals: JSON.stringify(signals),\n    entity_check: '',\n    company_number: '',\n    route: '',\n    owner_name: '',\n    email: '',\n    email_status: '',\n    email_source: '',\n    harvested_at: new Date().toISOString(),\n    scored_at: '',\n  }});\n}\n\nreturn out;"
      },
      "id": "map_filter",
      "name": "Map + filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1872,
