    {
      "parameters": {
        "url": "=https://api.apify.com/v2/datasets/{{ $('Start Apify run').item.json.data.defaultDatasetId }}/items?clean=true&format=json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
