      "id": "read_config",
      "name": "Read config",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cfg = {};\nfor (const r of rows) { cfg[r.key] = r.value; }\nfunction toArray(v) {\n  try { const p = JSON.parse(v); return Array.isArray(p) ? p : []; } catch (e) { return []; }\n}\nconst cities = toArray(cfg['geography.uk.cities']);\nconst cursor = parseInt(cfg['harvest.cityCursor'] || '0', 10) || 0;\nif (!cities.length) { throw new Error('No cities configured in geography.uk.cities'); }\nconst cityIndex = cursor % cities.length;\nconst nextCursor = (cityIndex + 1) % cities.length;\nconst config = {\n  actorId: cfg['harvest.actorId'] || 'compass/crawler-google-places',\n  searchTerms: toArray(cfg['niche.searchTerms']),\n  excludeNamePatterns: toArray(cfg['niche.excludeNamePatterns']),\n  cities,\n  maxPlacesPerCity: parseInt(cfg['harvest.maxPlacesPerCity'] || '40', 10) || 40,\n  maxReviewsPerPlace: parseInt(cfg['harvest.maxReviewsPerPlace'] || '20', 10) || 20,\n};\nreturn [{ json: { config, city: cities[cityIndex], cityIndex, nextCursor } }];"
      },
      "id": "parse_config",
      "name": "Parse config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $json.config.actorId.replace('/', '~') }}/runs",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ searchStringsArray: $json.config.searchTerms, locationQuery: $json.city + ', United Kingdom', maxCrawledPlaces: $json.config.maxPlacesPerCity, maxCrawledPlacesPerSearch: Math.max(1, Math.ceil($json.config.maxPlacesPerCity / Math.max(1, $json.config.searchTerms.length))), language: 'en', maxReviews: $json.config.maxReviewsPerPlace, reviewsSort: 'newest', scrapeReviewsPersonalData: false }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "start_apify_run",
      "name": "Start Apify run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        720,
        320
      ],
      "credentials": {
        "httpHeaderAuth": {
