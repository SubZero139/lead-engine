    {
      "parameters": {
        "content": "## 2 · Apify harvest + poll loop\nStart the Google Places actor, then poll the run every 20s. RUNNING/READY loops back to Wait; SUCCEEDED continues; anything else stops with an error. runId + datasetId are read back via `$('Start Apify run')`.",
        "height": 520,
        "width": 900,
        "color": 5
      },
      "id": "sticky_2",
      "name": "Sticky Harvest",
      "type": "n8n-nodes-base.stickyNote",
