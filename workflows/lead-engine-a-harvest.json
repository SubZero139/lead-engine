    {
      "parameters": {
        "content": "## 3 · Map / filter / dedupe / store\nMap places to lead rows, drop closed or name-excluded listings, cap `reviews_json` at 30k chars, drop `place_id`s already in `leads`, then insert the rest.",
        "height": 320,
        "width": 1120,
        "color": 3
      },
      "id": "sticky_3",
      "name": "Sticky Map",
      "type": "n8n-nodes-base.stickyNote",
